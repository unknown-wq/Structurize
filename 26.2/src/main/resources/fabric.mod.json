{
  "schemaVersion": 1,
  "id": "structurize",
  "version": "${version}",

  "name": "Structurize",
  "description": "An astonishing way to copy & paste structures! Allows you to save structures of your choice into a file of small size, load them back and place them anywhere anytime, create various shapes using math formulas, and many other nice things a great builder would love to have.",
  "authors": [
    "LDT Team"
  ],
  "contact": {
    "homepage": "https://minecolonies.com/",
    "sources": "https://github.com/ldtteam/structurize",
    "issues": "https://github.com/ldtteam/structurize/issues/new/choose"
  },

  "license": "GPL-3.0-only",
  "icon": "structurize.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ldtteam.structurize.Structurize"
    ],
    "client": [
      "com.ldtteam.structurize.StructurizeClient"
    ],
    "fabric-datagen": [
      "com.ldtteam.structurize.datagen.StructurizeDataGenerator"
    ]
  },

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "domum_ornamentum": "*",
    "blockui": "*"
  }
}
